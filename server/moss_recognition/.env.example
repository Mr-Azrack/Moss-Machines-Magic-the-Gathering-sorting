# Set these as cPanel Python app environment variables; do NOT commit real values.
MOSS_API_KEY=replace-with-unique-random-secret-at-least-32-characters
MOSS_ADMIN_PASSWORD=replace-with-different-long-random-password
MOSS_SESSION_SECRET=replace-with-third-unique-random-secret-at-least-32-characters
# Must be private storage OUTSIDE public_html. Adjust to your cPanel username.
MOSS_DATA_DIR=/home/CPANEL_USERNAME/moss_private_data
MOSS_COOKIE_SECURE=1
